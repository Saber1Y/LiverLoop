# ---------------------------------------------------------------
# Liverloop - environment configuration
# Copy to .env.local and fill in real values. Never commit secrets.
# ---------------------------------------------------------------

# --- Livepeer Agent ---
# Key from https://daydream.live for the Livepeer Agent SDK service.
LIVEPEER_API_KEY=sk_live_xxx

# --- OriginTrail DKG (V10 node API) ---
# Local DKG V10 node endpoint (DKG V10 Base Testnet, deployed on Base Sepolia).
# The node owns its publishing wallet; no application-level private key is used.
DKG_ENDPOINT=http://127.0.0.1
DKG_PORT=9200
# Context graph id: <author address>/<label>. The node's agent wallet must hold
# Base Sepolia test ETH + test TRAC to publish.
DKG_CONTEXT_GRAPH=0xc376B7120f0F895a7853cc445B7b139374e1c0f8/liverloop
DKG_BLOCKCHAIN=base:84532

# --- LLM (OpenRouter, OpenAI-compatible) ---
OPENROUTER_API_KEY=sk-or-v1-xxx
# Optional secondary OpenRouter key used as a rotation fallback on errors/rate limits.
# OPENROUTER_API_KEY_2=sk-or-v1-yyy
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free
# Optional: explicit override. Set only if a specific model is wanted.
# OPENROUTER_MODEL_PLANNER=nex-agi/nex-n2.5-pro:free
# OPENROUTER_MODEL_CRITIC=nex-agi/nex-n2.5-pro:free

# Optional fallback providers (tried after OpenRouter).
# GROQ_API_KEY=gsk_xxx
# XAI_API_KEY=xai_xxx

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000